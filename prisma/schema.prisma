// Solo Grinding — ERD (section 9) + fields agreed in the requirements review.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Level row id == level number. minXp default = 20 * L^2 (level 1 = 0).
model Level {
  id    Int    @id
  minXp Int
  rank  String // E, D, C, B, A, S
  users User[]
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  password       String
  role           String    @default("STUDENT") // STUDENT | ADMIN
  levelId        Int       @default(1)
  level          Level     @relation(fields: [levelId], references: [id])
  totalXp        Int       @default(0)
  streak         Int       @default(0)
  lastActiveDate String? // Mongolia-time day (YYYY-MM-DD) of last on-time completion
  guildLeftAt    DateTime? // 7-day guild cooldown
  isSuspended    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  subjects     Subject[]
  xpLogs       XpLog[]
  dailyQuests  DailyQuest[]
  achievements UserAchievement[]
  guildMember  GuildMember?
  sessions     Session[]
  quizAttempts QuizAttempt[]
  quizReports  QuizReport[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Subject {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  tasks  Task[]
}

model Task {
  id             Int       @id @default(autoincrement())
  subjectId      Int
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title          String
  topic          String    @default("") // rule 2: lesson topic (2–100 chars), used by the AI quiz
  type           String // HOMEWORK | LAB | INDEPENDENT | EXAM_PREP | READING
  deadline       DateTime
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  status         String    @default("TODO") // TODO | LATE | DONE
  multiplier     Float?
  xpEarned       Int       @default(0)
  deadlineEdited Boolean   @default(false)
  quizBlockedReason String? // rule 25: why no AI quiz can be made for this topic
  quizAttempt    QuizAttempt?
}

model XpLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String // TASK | QUEST | ACHIEVEMENT | GUILD_QUEST | AI_QUIZ
  sourceId  Int?
  xpAmount  Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model QuestTemplate {
  id          Int          @id @default(autoincrement())
  title       String
  goalType    String // COMPLETE_N | COMPLETE_EARLY | COMPLETE_TYPE | CLEAR_OVERDUE
  taskType    String? // only for COMPLETE_TYPE
  targetValue Int
  xpReward    Int
  isActive    Boolean      @default(true)
  dailyQuests DailyQuest[]
}

model DailyQuest {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  Int
  template    QuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questDate   String // YYYY-MM-DD (Mongolia time)
  progress    Int           @default(0)
  isCompleted Boolean       @default(false)

  @@index([userId, questDate])
}

model Achievement {
  id            Int               @id @default(autoincrement())
  name          String
  description   String
  conditionType String // STREAK | TASKS_DONE | EARLY_TASKS | LEVEL | PERFECT_QUIZ
  threshold     Int
  xpReward      Int
  users         UserAchievement[]
}

model UserAchievement {
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId Int
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@id([userId, achievementId])
}

model Guild {
  id         Int           @id @default(autoincrement())
  name       String
  inviteCode String        @unique
  createdAt  DateTime      @default(now())
  members    GuildMember[]
  quests     GuildQuest[]
}

model GuildMember {
  guildId  Int
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   Int      @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // LEADER | MEMBER
  joinedAt DateTime @default(now())

  @@id([guildId, userId])
}

model GuildQuest {
  id          Int     @id @default(autoincrement())
  guildId     Int
  guild       Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title       String
  goalType    String
  taskType    String?
  targetValue Int
  progress    Int     @default(0)
  weekStart   String // YYYY-MM-DD of Monday (Mongolia time)
  isCompleted Boolean @default(false)

  @@unique([guildId, weekStart])
}

// ---------- AI quiz (rules 23–30) ----------

// One generated question. Reused for the same subject + topic for 30 days (rule 28).
model QuizQuestion {
  id           Int          @id @default(autoincrement())
  subjectKey   String // normalized subject name
  topicKey     String // normalized topic
  rank         String // rank the question was generated for
  question     String
  options      String // JSON array of 4 strings
  correctIndex Int // index into options
  isInvalid    Boolean      @default(false) // admin confirmed a report (rule 29)
  createdAt    DateTime     @default(now())
  answers      QuizAnswer[]

  @@index([subjectKey, topicKey, createdAt])
}

// One quiz per DONE task (rule 23). taskId is cleared if the task is deleted with its subject.
model QuizAttempt {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      Int?         @unique
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subjectName String
  topic       String
  status      String       @default("IN_PROGRESS") // IN_PROGRESS | FINISHED
  score       Int          @default(0)
  xpEarned    Int          @default(0)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  answers     QuizAnswer[]

  @@index([userId, startedAt])
}

model QuizAnswer {
  id          Int          @id @default(autoincrement())
  attemptId   Int
  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  Int
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position    Int // 0..4
  optionOrder String // JSON permutation: display index -> original option index (rule 26)
  servedAt    DateTime? // when the 30-second timer started
  answeredAt  DateTime?
  chosenIndex Int? // original option index
  outcome     String? // CORRECT | WRONG | TIMEOUT | LEFT
  isCorrect   Boolean      @default(false)
  report      QuizReport?

  @@unique([attemptId, position])
}

model QuizReport {
  id         Int        @id @default(autoincrement())
  answerId   Int        @unique
  answer     QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  status     String     @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt  DateTime   @default(now())
  reviewedAt DateTime?

  @@index([status])
}

// Gemini call log for the admin AI stats.
model AiLog {
  id        Int      @id @default(autoincrement())
  kind      String // GENERATED | REUSED | REJECTED_TOPIC | ERROR
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}
